              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "max_Juegos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
