  "components": {
    "schemas": {
      "CartPurchaseItem": {
        "type": "object",
        "properties": {
          "id_Licencia": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cantidad": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
