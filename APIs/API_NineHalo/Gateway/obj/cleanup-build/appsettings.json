{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "usuario-registro": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/api/registro/{**catch-all}"
        }
      },
      "usuario-login": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/api/login/{**catch-all}"
        }
      },
      "usuario-password": {
        "ClusterId": "usuario-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/perfil/{id}/password/{**catch-all}"
        }
      },
      "persona-route": {
        "ClusterId": "persona-cluster",
        "Match": {
          "Path": "/api/perfil/{**catch-all}"
        }
      },
      "licencias-route": {
        "ClusterId": "licencias-cluster",
        "Match": {
          "Path": "/api/licencias/{**catch-all}"
        }
      },
      "compras-route": {
        "ClusterId": "compras-cluster",
        "Match": {
          "Path": "/api/compras/{**catch-all}"
        }
      },
      "estadisticas-route": {
        "ClusterId": "estadisticas-cluster",
        "Match": {
          "Path": "/api/estadisticas/{**catch-all}"
        }
      },
      "soporte-route": {
        "ClusterId": "soporte-cluster",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        }
      },
      "conversaciones-route": {
        "Match": {
          "Path": "/api/conversaciones/{**catch-all}"
        },
        "ClusterId": "soporte-cluster"
      },
      "usuario-authenticator": {
        "ClusterId": "usuario-cluster",
        "Order": -20,
        "Match": {
          "Path": "/api/perfil/autenticador/{**catch-all}"
        }
      },
      "usuario-ubicaciones": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/api/ubicaciones/{**catch-all}"
        }
      },
      "tse": {
        "ClusterId": "tse",
        "Match": {
          "Path": "/api/personas/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "banco": {
        "ClusterId": "banco",
        "Match": {
          "Path": "/api/pagos/{**catch-all}",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "usuario-cluster": {
        "Destinations": {
          "usuario": {
            "Address": "http://localhost:5145/"
          }
        }
      },
      "persona-cluster": {
        "Destinations": {
          "persona": {
            "Address": "http://localhost:5090/"
          }
        }
      },
      "licencias-cluster": {
        "Destinations": {
          "licencias": {
            "Address": "http://localhost:5233/"
          }
        }
      },
      "compras-cluster": {
        "Destinations": {
          "compras": {
            "Address": "http://localhost:5072/"
          }
        }
      },
      "estadisticas-cluster": {
        "Destinations": {
          "estadisticas": {
            "Address": "http://localhost:5128/"
          }
        }
      },
      "soporte-cluster": {
        "Destinations": {
          "soporte": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "tse": {
        "Destinations": {
          "tse": {
            "Address": "http://localhost:3006/"
          }
        }
      },
      "banco": {
        "Destinations": {
          "banco": {
            "Address": "http://localhost:3005/"
          }
        }
      }
    }
  }
}
