    {
      "name": "Partner API (Python)",
      "item": [
        {
          "name": "Consultar catálogo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{partnerDemoKey}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/partners/v1/licencias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar pedido pendiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{partnerDemoKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/partners/v1/pedidos",
            "description": "Crea un pedido pendiente. Cambia la referencia para un pedido nuevo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referencia\": \"TIENDA-POSTMAN-001\",\n  \"id_licencia\": 2,\n  \"cantidad\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200,201]).to.include(pm.response.code));",
                  "if ([200, 201].includes(pm.response.code)) pm.collectionVariables.set(\"pedidoSocioId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar pedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{partnerDemoKey}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/partners/v1/pedidos/{{pedidoSocioId}}",
            "description": "Ejecuta primero Registrar pedido pendiente o configura pedidoSocioId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar estadísticas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{partnerDemoKey}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/partners/v1/estadisticas?desde={{desde}}&hasta={{hasta}}",
            "description": "Solo incluye pedidos confirmados del socio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
