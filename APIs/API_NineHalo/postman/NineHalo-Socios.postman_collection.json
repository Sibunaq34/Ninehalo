{
  "info": {
    "name": "NineHalo - APIs de socios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Arranca YARP y las APIs correspondientes. Ejecuta las consultas manualmente. Los POST pueden crear pedidos, ventas, casos o avisos. Usa tu entorno local de pruebas."
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:5253"
    },
    {
      "key": "salesforceKey",
      "value": ""
    },
    {
      "key": "contaCloudKey",
      "value": ""
    },
    {
      "key": "notifyHubKey",
      "value": ""
    },
    {
      "key": "promoHubKey",
      "value": ""
    },
    {
      "key": "partnerDemoKey",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "claveOperacion",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "pedidoSocioId",
      "value": ""
    },
    {
      "key": "desde",
      "value": "2026-11-01"
    },
    {
      "key": "hasta",
      "value": "2026-11-30"
    }
  ],
  "item": [
    {
      "name": "Salesforce",
      "item": [
        {
          "name": "Listar casos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{salesforceKey}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/socios/salesforce/casos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar caso de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{salesforceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/socios/salesforce/casos",
            "description": "Crea un caso local en Salesforce. Para ensayar el callback, usa un ticket real creado desde la PWA.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_conversacion\": \"900000001\",\n  \"id_compra\": \"0\",\n  \"asunto\": \"Prueba Postman\",\n  \"detalle\": \"Caso sintético local.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Responder ticket de NineHalo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{salesforceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/socios/salesforce/respuestas",
            "description": "Configura ticketId con un ticket enviado a Salesforce. Requiere AgentId configurado en APISoporte.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_conversacion\": \"{{ticketId}}\",\n  \"contenido\": \"Respuesta de prueba desde Postman.\",\n  \"estado\": \"EN_PROCESO\",\n  \"referencia\": \"postman-{{ticketId}}-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
